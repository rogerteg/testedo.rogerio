# Automatic1 Installer — exemplo de configuração (feature 005)
# Copie para `.env` (ou exporte no ambiente) e ajuste conforme o host.
# Sem segredos embutidos: valores sensíveis entram por cofre/variáveis de ambiente.

# Diretório de estado (marcadores de idempotência e manifesto).
AUTOMATIC1_STATE_DIR=/var/lib/automatic1

# Arquivo de manifesto (serviço | versão | url).
AUTOMATIC1_MANIFESTO=

# 1 = apenas valida pré-requisitos (--check), sem aplicar mudanças.
AUTOMATIC1_DRY_RUN=0

# 1 = executa o bootstrap da infraestrutura base (Docker + Swarm).
AUTOMATIC1_BOOTSTRAP=1

# Lista de aplicações a instalar (espaço separado): ex. `n8n`.
AUTOMATIC1_APPS=

# Domínio base (Traefik/TLS) e email ACME (passos a validar em host Debian).
AUTOMATIC1_DOMAIN=
AUTOMATIC1_TRAEFIK_EMAIL=

# Aplicação de referência (N8N).
AUTOMATIC1_N8N_DOMAIN=
AUTOMATIC1_N8N_VERSION=latest
